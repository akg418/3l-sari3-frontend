# Base URL of the backend REST API
VITE_API_URL=http://localhost:3005/api

# WebSocket on/off. Keep false on Vercel. When false, the header shows a
# Sync button and the app syncs automatically every VITE_POLL_INTERVAL_MS.
VITE_REALTIME_ENABLED=false
VITE_POLL_INTERVAL_MS=300000

# WebSocket endpoint (only used when VITE_REALTIME_ENABLED=true). Leave empty to derive it from VITE_API_URL,
# which is what you want whenever the API and the socket share a host.
VITE_WS_URL=ws://localhost:3005/ws

# Human readable product name shown in the header
VITE_APP_NAME=3l sari3
