# Base URL of the backend REST API
VITE_API_URL=http://localhost:3005/api

# WebSocket endpoint. Leave empty to derive it from VITE_API_URL,
# which is what you want whenever the API and the socket share a host.
VITE_WS_URL=ws://localhost:3005/ws

# Human readable product name shown in the header
VITE_APP_NAME=3l sari3
